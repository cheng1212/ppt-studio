{
  "_meta": "选型规约 v2（2026-10-05）：新增 关系 维度。版式跟着内容关系走，不为变而变。",
  "关系定义": {
    "图文": "有信息型配图，图与文字互证（如曲线+解读、照片+要点）",
    "对照": "两者或多者并列对比（如表格对照）",
    "并列": "各条同等重要，无先后顺序（如多个目标、多条特征、多个易错点）",
    "流程": "有先后/递进/因果顺序（如步骤链、判断链、平衡建立过程）",
    "结构": "封面/目录/章节等结构页，不承载知识点"
  },
  "关系闭集": [
    "并列",
    "流程",
    "图文",
    "对照",
    "结构"
  ],
  "判定规则": "意图为因果/流程/方法时，先判定内容关系：真因果链（后一步由前一步推出）→关系=流程；名义因果实为并列清单→关系=并列。判定结论必须写入 _选型.理由。",
  "意图闭集": [
    "亮点",
    "关键指标",
    "分支",
    "历程",
    "因果",
    "增减构成",
    "对比",
    "封面",
    "循环",
    "性质",
    "数据对比",
    "方法",
    "构成",
    "流程",
    "漏斗",
    "特征",
    "目录",
    "目标达成",
    "相关性",
    "章节",
    "趋势"
  ],
  "映射": {
    "分支": [
      {
        "tpl": "flow_branch",
        "何时用": "一因多果/条件分支",
        "关系": [
          "流程"
        ]
      }
    ],
    "历程": [
      {
        "tpl": "timeline",
        "何时用": "时间线/历程",
        "关系": [
          "流程"
        ]
      }
    ],
    "因果": [
      {
        "tpl": "photo_chain",
        "何时用": "真因果链（后一步由前一步推出），可配图",
        "关系": [
          "流程",
          "图文"
        ]
      },
      {
        "tpl": "photo_props",
        "何时用": "名义因果、实为并列清单时降级用",
        "关系": [
          "并列"
        ]
      }
    ],
    "对比": [
      {
        "tpl": "table_compare",
        "何时用": "两者或多者对照；可选配图位（16:9 图表用 contain 显示）",
        "关系": [
          "对照",
          "图文"
        ]
      },
      {
        "tpl": "compare_bars",
        "关系": [
          "对照"
        ],
        "何时用": "两组数据多维度对比条（a_name/b_name组名，1-6行）"
      },
      {
        "tpl": "chart",
        "关系": [
          "对照"
        ],
        "何时用": "多维能力对比：雷达图（程序/图表.py radar，3-8维）"
      }
    ],
    "封面": [
      {
        "tpl": "cover",
        "何时用": "全书封面，大图背景+压字",
        "关系": [
          "结构"
        ]
      },
      {
        "tpl": "cover_split",
        "关系": [
          "结构"
        ],
        "何时用": "封面变体：左文右图 60/40，人物/产品特写图，文字区干净无压字"
      }
    ],
    "循环": [
      {
        "tpl": "flow_cycle",
        "何时用": "循环过程",
        "关系": [
          "流程"
        ]
      }
    ],
    "性质": [
      {
        "tpl": "photo_props",
        "何时用": "性质/定义类并列要点；有信息型配图时左图右文，无图走纯文字分支（须 --无图放行）",
        "关系": [
          "并列",
          "图文"
        ]
      },
      {
        "tpl": "cards3",
        "何时用": "三条并列内容横向三卡片，无配图",
        "关系": [
          "并列"
        ]
      },
      {
        "tpl": "equation_hero",
        "何时用": "性质页有核心方程式/公式时，方程式大字居中为视觉中心+三横卡",
        "关系": [
          "并列"
        ]
      }
    ],
    "方法": [
      {
        "tpl": "photo_chain",
        "何时用": "方法步骤链，可配图",
        "关系": [
          "流程",
          "图文"
        ]
      },
      {
        "tpl": "stepper",
        "何时用": "步骤链横向 2–4 步排布，提示框沉底",
        "关系": [
          "流程"
        ]
      },
      {
        "tpl": "photo_props",
        "何时用": "方法实为并列要点时降级用",
        "关系": [
          "并列"
        ]
      }
    ],
    "流程": [
      {
        "tpl": "photo_chain",
        "何时用": "步骤链/判断链，可配图",
        "关系": [
          "流程",
          "图文"
        ]
      },
      {
        "tpl": "stepper",
        "何时用": "步骤链横向 2–4 步排布，提示框沉底",
        "关系": [
          "流程"
        ]
      },
      {
        "tpl": "photo_props",
        "何时用": "步骤名义上是流程、实为并列要点时降级用",
        "关系": [
          "并列"
        ]
      }
    ],
    "特征": [
      {
        "tpl": "photo_props",
        "何时用": "特征类并列要点；有信息型配图时左图右文，无图走纯文字分支（须 --无图放行）",
        "关系": [
          "并列",
          "图文"
        ]
      },
      {
        "tpl": "cards3",
        "何时用": "三条并列内容横向三卡片，无配图",
        "关系": [
          "并列"
        ]
      }
    ],
    "目录": [
      {
        "tpl": "toc_grid",
        "何时用": "目录页",
        "关系": [
          "结构"
        ]
      }
    ],
    "章节": [
      {
        "tpl": "section",
        "何时用": "章节过渡；tone=light 为浅色版（A 方案），缺省深色",
        "关系": [
          "结构"
        ]
      }
    ],
    "数据对比": [
      {
        "tpl": "chart",
        "关系": [
          "对照"
        ],
        "何时用": "分类数据对比：能画bar用chart（直观），需精确值时用table_compare"
      },
      {
        "tpl": "compare_bars",
        "关系": [
          "对照"
        ],
        "何时用": "两组数据横向条形对比（我方vs竞品/本期vs上期），结论先行，条宽按极值归一化"
      },
      {
        "tpl": "table_compare",
        "关系": [
          "对照"
        ],
        "何时用": "多属性精确值对比：3-6列，短表头"
      }
    ],
    "趋势": [
      {
        "tpl": "chart",
        "关系": [
          "流程"
        ],
        "何时用": "时间序列变化：折线图（程序/图表.py line）；分类数据不许连线"
      },
      {
        "tpl": "chart",
        "关系": [
          "流程"
        ],
        "何时用": "两变量相关性：散点图（程序/图表.py scatter，≥5点）"
      }
    ],
    "构成": [
      {
        "tpl": "chart",
        "关系": [
          "结构"
        ],
        "何时用": "整体构成：pie≤5片（超了先分组为Other），默认考虑bar"
      },
      {
        "tpl": "equation_hero",
        "关系": [
          "结构"
        ],
        "何时用": "公式/等式视觉锤：中央大方程式 + 三要素卡片"
      }
    ],
    "关键指标": [
      {
        "tpl": "kpi_hero",
        "关系": [
          "并列"
        ],
        "何时用": "1-4个关键数字：巨型数字+上下文（YoY/目标），标出1个主角"
      }
    ],
    "漏斗": [
      {
        "tpl": "chart",
        "关系": [
          "流程"
        ],
        "何时用": "转化流程：漏斗图（程序/图表.py funnel，2-6阶段，显示转化率）"
      }
    ],
    "增减构成": [
      {
        "tpl": "chart",
        "关系": [
          "结构"
        ],
        "何时用": "增减→总计：瀑布图（程序/图表.py waterfall）"
      }
    ],
    "目标达成": [
      {
        "tpl": "chart",
        "关系": [
          "对照"
        ],
        "何时用": "实际 vs 目标：子弹图（程序/图表.py bullet）"
      },
      {
        "tpl": "number_hero",
        "关系": [
          "对照"
        ],
        "何时用": "单数字视觉锤：达成率/里程碑数字大字突出，配图标"
      }
    ],
    "相关性": [
      {
        "tpl": "chart",
        "关系": [
          "对照"
        ],
        "何时用": "两变量关系：散点图（程序/图表.py scatter）"
      }
    ],
    "亮点": [
      {
        "tpl": "infographic",
        "关系": [
          "并列"
        ],
        "何时用": "2-4个数字+图标的高光展示（图标库35个，icon字段中文名）"
      },
      {
        "tpl": "number_hero",
        "关系": [
          "并列"
        ],
        "何时用": "一个数字值得占半页做视觉 hammer（200px大数字）"
      },
      {
        "tpl": "kpi_hero",
        "关系": [
          "并列"
        ],
        "何时用": "3-4个KPI并列（已有）"
      }
    ]
  },
  "版式原则": [
    "统一层：配色/字体/字号层级/间距全套统一，不随版式变化——这是“一套”的感觉来源",
    "变化层：版式跟着内容关系走（并列→横向/分栏，流程→步骤链，图文→左右布局，对照→表格），不为变而变",
    "同类内容（同关系）保持同一体例，形成阅读预期",
    "节奏：连续不超过 3 页使用同一版式；疏密交替"
  ],
  "纪律": [
    "候选必须严格等于 映射[意图]按关系过滤后的结果，不许自行增删",
    "_选型.选中必须等于条目 tpl",
    "_选型.理由必须如实记录判定依据或拍板过程，不许空泛",
    "_选型.关系必填（2026-10-05 前已存在的旧记录缺该字段时按 v1 规则 grandfather 校验）"
  ],
  "说明": "页型选型规约：内容意图 + 内容关系 → 候选页型的确定性映射。选型是拍板步骤；映射本身不许发挥。",
  "选型记录字段": {
    "_选型": "条目级字段，内容：{意图, 关系, 候选[], 选中, 理由}"
  },
  "关系决策表": {
    "并列": "cards3/kpi_hero（2-4卡等分；4项用2×2）",
    "流程": "photo_chain/stepper/timeline/chart-line（3-6步，点线连接）",
    "对照": "table_compare/chart-bar（等分，平行语法，强调色标胜出侧）",
    "结构": "section/toc_grid/chart-pie（顶层=总论点）",
    "图文": "photo_props（图左文右/图右文左，60/40分栏）",
    "说明": "版式跟着内容关系走，不跟着审美走（专家报告Topic 5.1）"
  }
}