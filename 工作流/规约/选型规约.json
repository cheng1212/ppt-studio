{
  "_meta": "选型规约 v2（2026-10-05）：新增 关系 维度。版式跟着内容关系走，不为变而变。",
  "关系定义": {
    "图文": "有信息型配图，图与文字互证（如曲线+解读、照片+要点）",
    "对照": "两者或多者并列对比（如表格对照）",
    "并列": "各条同等重要，无先后顺序（如多个目标、多条特征、多个易错点）",
    "流程": "有先后/递进/因果顺序（如步骤链、判断链、平衡建立过程）",
    "结构": "封面/目录/章节等结构页，不承载知识点"
  },
  "关系闭集": [
    "并列",
    "流程",
    "图文",
    "对照",
    "结构"
  ],
  "判定规则": "意图为因果/流程/方法时，先判定内容关系：真因果链（后一步由前一步推出）→关系=流程；名义因果实为并列清单→关系=并列。判定结论必须写入 _选型.理由。",
  "意图闭集": [
    "亮点",
    "关键指标",
    "分支",
    "历程",
    "因果",
    "增减构成",
    "对比",
    "封面",
    "循环",
    "性质",
    "数据对比",
    "方法",
    "构成",
    "流程",
    "漏斗",
    "特征",
    "目录",
    "目标达成",
    "相关性",
    "章节",
    "趋势",
    "收束",
    "人物"
  ],
  "映射": {
    "分支": [
      {
        "tpl": "flow_branch",
        "何时用": "一因多果/条件分支",
        "关系": [
          "流程"
        ]
      }
    ],
    "历程": [
      {
        "tpl": "timeline",
        "何时用": "时间线/历程",
        "关系": [
          "流程"
        ]
      },
      {
        "tpl": "timeline_vertical",
        "何时用": "纵向时间线：左侧rail＋dot，日期弱化＋标题加粗（4–8节点）",
        "关系": [
          "流程"
        ]
      },
      {
        "tpl": "roadmap_swimlane",
        "何时用": "泳道路线图：列＝季度、行＝workstream，任务条跨列，NOW竖线",
        "关系": [
          "流程"
        ]
      }
    ],
    "因果": [
      {
        "tpl": "photo_chain",
        "何时用": "真因果链（后一步由前一步推出），可配图",
        "关系": [
          "流程",
          "图文"
        ]
      },
      {
        "tpl": "photo_props",
        "何时用": "名义因果、实为并列清单时降级用",
        "关系": [
          "并列"
        ]
      },
      {
        "tpl": "chart_waterfall",
        "关系": [
          "因果"
        ],
        "何时用": "总量从A到B的驱动拆解：瀑布图（因素≤8，加总关系）"
      },
      {
        "tpl": "chart_pareto",
        "关系": [
          "因果"
        ],
        "何时用": "客诉/成本动因二八分析：帕累托"
      },
      {
        "tpl": "scr_brief",
        "何时用": "SCR一页纸：S背景/C冲突/R结论三段纵向；只写S不写C的无张力摘要禁入",
        "关系": [
          "流程"
        ]
      },
      {
        "tpl": "case_arc",
        "何时用": "转变弧：旧世界→转折点→方法→新世界；Turning Point不可缺",
        "关系": [
          "流程",
          "图文"
        ]
      }
    ],
    "对比": [
      {
        "tpl": "table_compare",
        "何时用": "两者或多者对照；可选配图位（16:9 图表用 contain 显示）",
        "关系": [
          "对照",
          "图文"
        ]
      },
      {
        "tpl": "compare_bars",
        "关系": [
          "对照"
        ],
        "何时用": "两组数据多维度对比条（a_name/b_name组名，1-6行）"
      },
      {
        "tpl": "chart",
        "关系": [
          "对照"
        ],
        "何时用": "多维能力对比：雷达图（程序/图表.py radar，3-8维）"
      },
      {
        "tpl": "chart_ranked",
        "关系": [
          "对照"
        ],
        "何时用": "类别排名：横向条形严格排序，条上直接标值（类别≤10）"
      },
      {
        "tpl": "chart_dumbbell",
        "关系": [
          "对照"
        ],
        "何时用": "前后对比：每类一行两点一线看差距（改革前后/竞品vs我方/目标vs实际）"
      },
      {
        "tpl": "chart_combo",
        "关系": [
          "对照"
        ],
        "何时用": "量价双指标：柱（绝对值）+线（比率）双轴；仅真实配对的一升一降故事"
      },
      {
        "tpl": "compare_vs",
        "何时用": "镜像双栏VS：要点逐条平行对位；两侧须对位回答同一问题，信息量对称",
        "关系": [
          "对照"
        ]
      },
      {
        "tpl": "compare_beforeafter",
        "何时用": "前后对比：左右分屏＋底部量化delta通栏",
        "关系": [
          "对照"
        ]
      },
      {
        "tpl": "compare_proscons",
        "何时用": "优劣清单：双栏pros/cons＋底部verdict推荐区；只罗列不给结论禁入",
        "关系": [
          "对照"
        ]
      },
      {
        "tpl": "matrix_2x2",
        "何时用": "2×2矩阵：轴标签＋象限名；装饰九宫格禁入",
        "关系": [
          "对照"
        ]
      },
      {
        "tpl": "scorecard_decision",
        "何时用": "决策记分卡：候选项评分条＋winner高亮＋理由条",
        "关系": [
          "对照"
        ]
      },
      {
        "tpl": "venn",
        "何时用": "集合间重叠关系：2-3 圆交集，交集区须标注意义",
        "关系": [
          "对照"
        ]
      }
    ],
    "封面": [
      {
        "tpl": "cover",
        "何时用": "全书封面，大图背景+压字",
        "关系": [
          "结构"
        ]
      },
      {
        "tpl": "cover_split",
        "关系": [
          "结构"
        ],
        "何时用": "封面变体：左文右图 60/40，人物/产品特写图，文字区干净无压字"
      },
      {
        "tpl": "cover_typo",
        "关系": [
          "结构"
        ],
        "何时用": "封面（大字报式纯文字）：发布会 Keynote、宣言式主题；标题短而有力、无好图可用时。文字即图形，零图片依赖。"
      },
      {
        "tpl": "cover_minimal",
        "关系": [
          "结构"
        ],
        "何时用": "封面（留白主导极简）：咨询公司、学术答辩、高端品牌；信息少、要“克制的高级感”时。"
      },
      {
        "tpl": "cover_block",
        "关系": [
          "结构"
        ],
        "何时用": "封面（图片独立色块）：现代商务、编辑风 deck；想用图片又不想被图片“吃掉”版面时。"
      },
      {
        "tpl": "cover_duo",
        "关系": [
          "结构"
        ],
        "何时用": "封面（双色拼接）：品牌色强势、年轻化产品、系列化 deck（封面/章节页可换色延续）。"
      },
      {
        "tpl": "cover_diagonal",
        "关系": [
          "结构"
        ],
        "何时用": "封面（斜切对角）：科技、运动、青年文化主题；发布会主视觉。"
      },
      {
        "tpl": "cover_brand",
        "关系": [
          "结构"
        ],
        "何时用": "封面（品牌色底+图形）：VI 规范强的企业、系列培训/内部分享封面；无合适图片时最省力的高级感方案。"
      },
      {
        "tpl": "cover_magazine",
        "关系": [
          "结构"
        ],
        "何时用": "封面（杂志编辑风）：个人品牌、文化创意、年度特刊式总结；人物封面。"
      },
      {
        "tpl": "cover_lux",
        "关系": [
          "结构"
        ],
        "何时用": "封面（暗黑奢华）：高端产品、私人银行、奢侈品、晚宴式发布会。"
      },
      {
        "tpl": "cover_collage",
        "关系": [
          "结构"
        ],
        "何时用": "封面（多图拼贴）：活动回顾、作品集、文旅/校园主题；信息量大于单一情绪时。"
      },
      {
        "tpl": "cover_crop",
        "关系": [
          "结构"
        ],
        "何时用": "封面（超大裁切）：产品特写、时尚主题；图片局部比整体更有冲击力时。"
      },
      {
        "tpl": "cover_anchor",
        "关系": [
          "结构"
        ],
        "何时用": "封面（单锚点）：章节封面、年报式封面（巨型年份/数字）、Keynote 章节过渡。"
      },
      {
        "tpl": "cover_fusion",
        "关系": [
          "结构"
        ],
        "何时用": "封面（图字融合/双重曝光）：人物故事、创意/文艺主题封面。"
      },
      {
        "tpl": "cover_band",
        "关系": [
          "结构"
        ],
        "何时用": "封面（半出血图片带）：信息量大的工作汇报封面：既要图片氛围，又要放下较多文字。"
      },
      {
        "tpl": "cover_brush",
        "关系": [
          "结构"
        ],
        "何时用": "封面（笔刷书法）：党建、传统文化、国风品牌、节庆主题。"
      }
    ],
