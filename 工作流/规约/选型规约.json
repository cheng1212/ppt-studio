          "并列"
        ]
      },
      {
        "tpl": "framework_hub",
        "何时用": "中心概念＋4–6辐射节点（连线）",
        "关系": [
          "并列"
        ]
      },
      {
        "tpl": "case_psr",
        "何时用": "案例三段面板（Problem/Solution/Results）；Results必须量化before/after",
        "关系": [
          "并列",
          "图文"
        ]
      }
    ],
